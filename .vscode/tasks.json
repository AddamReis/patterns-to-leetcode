{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build active C++ file debug",
            "type": "shell",
            "command": "${workspaceFolder}\\scripts\\build.bat",
            "args": [
                "${relativeFile}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
